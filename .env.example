# =============================================================================
# Vinyl Together 服务端配置
# 本地开发：从仓库根目录复制到 packages/server/.env 并填写需要的值
# Docker 部署：通过 --env-file 或 -e 显式传入，不依赖镜像内的 .env
# =============================================================================
#
# 本地开发可不配置；生产环境必须设置 IDENTITY_SECRET。
# 使用 `openssl rand -hex 32` 生成一次并妥善保存，不要复用示例值。
#

# 身份 cookie 与本地音频签名 URL 的密钥（生产环境必填，至少 32 个字符）
# IDENTITY_SECRET=replace-with-a-random-secret

# 服务端端口（默认 3001）
# PORT=3001

# 客户端 URL（可选，用于 CORS 严格白名单模式）
# - 不设置：自动模式，允许所有来源访问（适用于单镜像部署、局域网、公网反代）
# - 设置为具体域名：严格白名单模式（适用于前后端分离跨域部署）
# CLIENT_URL=https://music.example.com

# 额外的 CORS origins（逗号分隔，可选）
# CORS_ORIGINS=https://other-domain.com,https://another.com

# 房间本地音频（默认写入服务工作目录下的专用子目录；生产环境建议绑定到独立数据盘）
# 该目录会在服务启动时清空 assets/tmp，不能设置为文件系统根目录、服务工作目录或其父目录
# LOCAL_AUDIO_DATA_DIR=./data/local-audio
# LOCAL_AUDIO_MAX_UPLOAD_MIB=500
# LOCAL_AUDIO_ROOM_QUOTA_MIB=1024
# LOCAL_AUDIO_SERVER_QUOTA_MIB=2560
# LOCAL_AUDIO_TEMP_QUOTA_MIB=1280
# LOCAL_AUDIO_MIN_FREE_MIB=1536
# LOCAL_AUDIO_FFPROBE_PATH=ffprobe
# LOCAL_AUDIO_FFMPEG_PATH=ffmpeg
# LOCAL_AUDIO_FFPROBE_TIMEOUT_MS=30000
# LOCAL_AUDIO_FFMPEG_TIMEOUT_MS=21600000
# 签名媒体 URL 有效期（默认 24 小时；应覆盖预期的最长单条录音）
# LOCAL_AUDIO_ACCESS_TOKEN_TTL_MS=86400000
# LOCAL_AUDIO_FFMPEG_THREADS=1
